{% extends 'base.html.twig' %}

{% block title %}{{ movie.titre }} ({{ movie.dateSortie|date('Y')}}) - Détails{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto my-12 px-4">
    <div class="bg-zinc-900 text-white rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row border border-zinc-600">
        {# Partie droite : Informations détaillées #}
        <div class="md:w-3/5 p-8 md:p-10 flex flex-col justify-between bg-zinc-900">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold mb-3">{{ movie.titre }}</h1>
                
                <div class="flex flex-wrap items-center gap-3 mb-8 text-sm text-zinc-400">
                    <span class="bg-amber-400 text-black font-extrabold px-2.5 py-1 rounded-md inline-flex items-center gap-1">
                        ★ {{ movie.notePresse }}/5
                    </span>
                    <span>•</span>
                    <span>{{ movie.genre.name }}</span>
                    <span>•</span>
                    <span>{{ movie.duree }} minutes</span>
                    <span>•</span>
                    <span>Année : {{ movie.dateSortie|date('Y') }}</span>
                </div>

                <div>
                    <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold mb-2">
                        Synopsis
                    </h2>
                    <p class="text-zinc-200 leading-relaxed text-base">
                        {% if movie.synopsis == 'N/A' or movie.synopsis is empty %}
                            <span class="italic text-zinc-500">Aucun synopsis disponible pour ce film pour le moment.</span>
                        {% else %}
                            {{ movie.synopsis }}
                        {% endif %}
                    </p>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-zinc-800">
                <a href="{{ path('app_movie_edit', {'id': movie.id}) }}" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition-colors duration-200">
                    <span>Modifier</span>
                </a>
            </div>

            <div class="mt-8 pt-6 border-t border-zinc-800">
                <a href="{{ path('app_movie_index') }}" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition-colors duration-200">
                    <span>←</span>
                    <span>Retour au catalogue</span>
                </a>
            </div>
        </div>

    </div>
</div>
{% endblock %}