{% extends 'base.html.twig' %}

{% block title %}Hello MovieController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>La base de données contient actuellement {{ movies|length }} films!</h1>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th class="px-2 py-2">Année sortie</th>
                <th>Note</th>
                <th>Synopsis</th>
                <th class="px-2 py-2">Favoris</th>
            </tr>
        </thead>
        <tbody>
            {% for movie in movies %}
                <tr>
                    <td class="px-2 py-2"> {{ movie.id }}</td>
                    <td class="px-4 py-2"> {{ movie.title }} <a href="{{ path('nom_movie_show', {'id': movie.id}) }}">📁</a></td>
                    <td class="px-4 py-2"> {{ movie.category|upper }}</td>
                    <td class="px-4 py-2"> {{ movie.releaseYear }}</td>
                    <td class="px-4 py-2"> {{ movie.rating }}</td>
                    <td class="px-4 py-2"> {{ movie.synopsis }}</td>
                    {% if movie.rating >= 4 %}
                        <td class="px-4 py-2">⭐</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
