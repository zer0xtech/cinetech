{% set current_route = app.request.attributes.get('_route') %}

<nav class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between min-h-16">
            
            <a href="{{ path('app_home') }}" class="text-xl font-bold text-indigo-600">
                Cinetech
            </a>

            <input type="checkbox" id="menu-toggle" class="peer hidden">
            
            <label for="menu-toggle" class="sm:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100 cursor-pointer">
                <span class="sr-only">Ouvrir le menu</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </label>

            <div class="hidden peer-checked:block w-full sm:flex sm:w-auto sm:items-center sm:space-x-8 pb-3 sm:pb-0 border-t sm:border-t-0 border-gray-200 mt-2 sm:mt-0 pt-2 sm:pt-0 space-y-1 sm:space-y-0">
                <a href="{{ path('app_home') }}" 
                   class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_home' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                    Home
                </a>
                <a href="{{ path('app_movie_index') }}" 
                   class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                    Catalogue
                </a>
                <a href="{{ path('app_category_index') }}" class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                    Catégories
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_movie_new') }}" class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                        Ajouter un film
                    </a>
                {% endif %}
                {% if app.user %}
                    <span class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}"> 
                        Connecté : <strong>{{ app.user.userIdentifier }}</strong>
                    </span>
                    <a href="{{ path('app_logout') }}"class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}"class="block sm:inline-block px-3 py-2 rounded-md sm:rounded-none text-base sm:text-sm font-medium transition-colors {{ current_route == 'app_contact' ? 'bg-indigo-50 sm:bg-transparent text-indigo-600 sm:border-b-2 sm:border-indigo-600' : 'text-gray-600 hover:bg-gray-50 sm:hover:bg-transparent hover:text-gray-900' }}">
                        Inscription
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</nav>